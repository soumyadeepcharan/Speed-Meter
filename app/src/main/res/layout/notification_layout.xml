<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:weightSum="4"
    android:gravity="center_vertical"
    android:paddingStart="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:paddingEnd="0dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16sp"
            android:layout_height="16sp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_notification_icon"
            android:padding="3sp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notification_down"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/notificationDownText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/notification_value_color" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16sp"
            android:layout_height="16sp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_notification_icon"
            android:padding="3sp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notification_up"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/notificationUpText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/notification_value_color" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16sp"
            android:layout_height="16sp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_notification_icon"
            android:padding="3sp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notification_data"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/notificationDataText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/notification_value_color" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16sp"
            android:layout_height="16sp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_notification_icon"
            android:padding="3sp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notification_wifi"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/notificationWifiText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/notification_value_color" />
    </LinearLayout>

</LinearLayout>
