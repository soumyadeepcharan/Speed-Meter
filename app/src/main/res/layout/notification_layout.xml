<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/notificationDownText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="2dp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="13sp"
        android:autoSizeStepGranularity="1sp" />

    <TextView
        android:id="@+id/notificationUpText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="2dp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="13sp"
        android:autoSizeStepGranularity="1sp" />

    <TextView
        android:id="@+id/notificationDataText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="2dp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="13sp"
        android:autoSizeStepGranularity="1sp" />

    <TextView
        android:id="@+id/notificationWifiText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="13sp"
        android:autoSizeStepGranularity="1sp" />

    <ImageView
        android:id="@+id/notificationSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_settings_black_24dp"
        android:alpha="0.5"
        android:visibility="gone"
        android:contentDescription="@string/notif_settings_button" />

</LinearLayout>
